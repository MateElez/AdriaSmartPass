generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  WON
  LOST
}

enum ProjectType {
  APARTMENT
  AIRBNB
  HOTEL
  OFFICE
  OTHER
}

model Lead {
  id          String      @id @default(uuid())
  fullName    String
  email       String
  phone       String
  company     String?
  projectType ProjectType
  message     String
  status      LeadStatus  @default(NEW)
  source      String      @default("website")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
  @@index([projectType])
  @@index([createdAt(sort: Desc)])
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
